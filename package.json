{
  "name": "agri-operations-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "check:structure": "node scripts/check-structure.mjs",
    "db:up": "docker compose --env-file .env -f infrastructure/compose.yaml up -d",
    "db:down": "docker compose --env-file .env -f infrastructure/compose.yaml down",
    "db:logs": "docker compose --env-file .env -f infrastructure/compose.yaml logs -f db",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "pnpm --filter @agri/database validate",
    "db:migrate:plan": "node scripts/native-migrations.mjs --plan",
    "db:migrate": "node scripts/native-migrations.mjs --apply",
    "device:enroll": "node scripts/device-enrollment.mjs enroll",
    "device:revoke": "node scripts/device-enrollment.mjs revoke",
    "test:browser": "node tests/browser/device-proof.mjs && node tests/browser/admin-registry.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@tanstack/react-query": "5.90.21",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "fake-indexeddb": "6.2.4",
    "jsdom": "^26.1.0",
    "pg": "8.16.3",
    "playwright": "1.62.1",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "supertest": "^7.1.4",
    "turbo": "^2.5.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
