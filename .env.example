# Local development only. Never commit .env or production secrets.
POSTGRES_DB=agri_dev
POSTGRES_USER=agri_bootstrap
POSTGRES_PASSWORD=change-this-in-local-env
POSTGRES_PORT=5432
# Bootstrap credentials are only for initial local infrastructure; do NOT use as the API DB role.
DATABASE_URL_BOOTSTRAP=postgresql://agri_bootstrap:change-this-in-local-env@localhost:5432/agri_dev
# Populate this only after a restricted api_runtime role and RLS are deployed/tested.
DATABASE_URL_RUNTIME=
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Separate reviewed migration identity. Supply its URL through a secret environment.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_NAME=agri_dev
