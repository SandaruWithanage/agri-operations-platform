{
  "name": "@agri/validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
    "build": "node ../../scripts/typecheck.mjs -p tsconfig.build.json && node build.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts"
}
