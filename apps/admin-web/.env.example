NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only BFF configuration. Keep real keys outside version control.
PILOT_API_ORIGIN=
PILOT_PUBLIC_ORIGIN=
PILOT_INTERNAL_KEY=
# Number of trusted reverse proxies in front of this BFF that append to X-Forwarded-For (0 = trust none).
# Required for per-client login throttling in production; see docs/development/PILOT_AUTH_RUNTIME.md.
PILOT_TRUSTED_PROXY_HOPS=0
