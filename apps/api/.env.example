API_PORT=4000

# Optional pilot runtime: disabled unless explicitly configured.
ENABLE_PILOT_AUTH=false
# Server-only secret shared with both Next.js BFFs (minimum 43 random characters).
PILOT_INTERNAL_KEY=
# JSON map from each NOLOGIN group role to a separate LOGIN connection URL.
# Ten restricted LOGIN connections: credential/MFA/throttle/session issuer/executor/reader,
# farmer runtime, device verifier, agri_land_runtime, and agri_project_runtime. See PILOT_AUTH_RUNTIME.md.
PILOT_DATABASE_URLS=
# JSON key-id to base64 AES-256 key map, from a deployment secret manager.
PILOT_MFA_KEYS=
PILOT_THROTTLE_KEY=
PILOT_CSRF_KEY=
PILOT_ACTOR_KEY=
PILOT_DEVICE_CHALLENGE_KEY=
# PKCS8 RSA private key (2048+ bits); keep outside the repository.
PILOT_JWT_PRIVATE_KEY=
PILOT_JWT_KID=
PILOT_JWT_ISSUER=
PILOT_JWT_AUDIENCE=
# Comma-separated exact HTTPS browser origins.
PILOT_ORIGINS=
PILOT_JWT_SECONDS=300
PILOT_IDLE_SECONDS=1800
PILOT_ABSOLUTE_SECONDS=28800

# Provisional maximum local drafting window after online verification (60..86400 seconds).
PILOT_OFFLINE_SECONDS=3600

# HTTP hardening (all optional; see docs/development/PILOT_AUTH_RUNTIME.md)
# Browser origins allowed to call the API directly. Leave empty in production: the API is reached only by the BFF.
API_CORS_ORIGINS=
# Concurrent request cap before load is shed with 503 (1-10000).
API_MAX_IN_FLIGHT=256
# JSON body cap in bytes (1024-1048576).
API_MAX_BODY_BYTES=262144

