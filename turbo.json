{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "@agri/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["API_PORT", "ENABLE_PILOT_AUTH", "PILOT_*"]
    },
    "@agri/admin-web#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PILOT_*"]
    },
    "@agri/field-pwa#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PILOT_*"]
    }
  },
  "globalEnv": ["DATABASE_URL", "NEXT_TELEMETRY_DISABLED"]
}
